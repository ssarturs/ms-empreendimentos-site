{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ms-empreendimentos-site",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
